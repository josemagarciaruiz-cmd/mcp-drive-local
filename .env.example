# Copia a .env y rellena. NO subir .env a GitHub.

# Mismas credenciales OAuth que el conector alojado (del cliente)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REFRESH_TOKEN=xxxxxxxx

# Carpetas del ordenador que el agente puede tocar (separadas por ':')
# El agente NO accederá a nada fuera de estas rutas.
ALLOWED_DIRS=~/Downloads:~/Documents

# Red local (no exponer a internet)
AGENT_HOST=127.0.0.1
AGENT_PORT=8765
